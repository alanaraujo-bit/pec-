# Copie para .env e preencha. O .env real nunca vai para o repositório.

# String de conexão do Postgres. No Railway, use a URL pública do serviço Postgres
# para rodar localmente, e a interna (postgres.railway.internal) dentro do container.
DATABASE_URL="postgresql://usuario:senha@host:porta/banco"

# Segredo de assinatura dos tokens. Gere um valor longo e aleatório por ambiente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET="troque-por-um-segredo-aleatorio-longo"

PORT=3333
LOG_LEVEL=info
