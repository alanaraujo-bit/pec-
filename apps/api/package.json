{
  "name": "@pece/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-transform-types src/server.ts",
    "start": "node --experimental-transform-types src/server.ts",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node --experimental-transform-types prisma/seed.ts",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "prisma": {
    "seed": "node --experimental-transform-types prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@pece/core": "*",
    "@prisma/client": "^6.16.1",
    "fastify": "^5.6.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prisma": "^6.16.1",
    "typescript": "~6.0.3"
  }
}
